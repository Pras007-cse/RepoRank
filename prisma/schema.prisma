// RepoRank database schema
// PostgreSQL is the primary target; GitHub is treated as the source of truth
// for star state, this schema only caches/verifies what GitHub reports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js models) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // GitHub identity
  githubId       Int?    @unique
  githubLogin    String? @unique
  githubBio      String?
  githubUrl      String?
  publicRepos    Int?
  followers      Int?

  // Encrypted GitHub access token. Only ever populated for users who used
  // the optional "Verify instantly with GitHub" OAuth convenience — never
  // required, never used to act on GitHub on the user's behalf anymore
  // (see Star model comment: the star mechanism is detection-only now).
  githubAccessTokenEnc String? @db.Text

  // ---------- Progressive builder identity verification ----------
  // A user becomes a "verified builder" one of two ways: completing the
  // zero-permission bio-challenge below, or using the optional OAuth
  // convenience (which sets this immediately, since OAuth proves control
  // at least as strongly). Nothing privileged (claiming a project, sending
  // or accepting connections, editing project profiles) is gated on
  // anything else.
  builderVerified                Boolean   @default(false)
  verifiedAt                     DateTime?
  verificationChallengeHash      String? // sha256 of the short code, not the code itself
  verificationChallengeExpiresAt DateTime?

  // Derived, cached scoring fields for the *legacy* "stars given" leaderboard
  // (kept as a secondary view alongside the new received-stars ranking —
  // see Repository.verifiedStarsReceived below for the primary metric).
  contributionScore Int      @default(0)
  rank              Int?
  lastSyncedAt      DateTime?

  accounts     Account[]
  sessions     Session[]
  stars        Star[]
  events       ActivityEvent[]
  ownedRepos   Repository[]      @relation("RepositoryOwner")
  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionAddressee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contributionScore])
  @@index([builderVerified])
}

model Repository {
  id          String   @id @default(cuid())
  githubId    Int      @unique
  owner       String
  name        String
  fullName    String   @unique
  description String?  @db.Text
  url         String
  language    String?
  topics      String[] @default([])
  category    Category @default(OTHER)

  // ---------- Ownership (unclaimed by default) ----------
  // null = unclaimed. Repository submission never requires this to be set —
  // anyone can register a repo by pasting its URL. It's only ever set by a
  // successful ownership verification for a *verified builder* whose
  // githubLogin matches this repo's real `owner` (per the GitHub API),
  // never by trusting whoever submitted the URL.
  ownerUserId String?
  ownerUser   User?     @relation("RepositoryOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  claimedAt   DateTime?

  stargazersCount Int      @default(0) // cached from GitHub, refreshed periodically

  lastFetchedAt   DateTime @default(now())

  stars  Star[]
  events ActivityEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([language])
  @@index([category])
  @@index([stargazersCount])
  @@index([ownerUserId])
}

enum Category {
  WEB
  MOBILE
  AI_ML
  DEVOPS
  DATABASE
  SECURITY
  GAME_DEV
  CLI_TOOLING
  LIBRARY
  OTHER
}

// A verified star: a User (a *verified builder*) currently has an active,
// real GitHub star on a Repository, detected by polling their public
// starred list — never granted by this app acting on their behalf. GitHub
// is authoritative: this row must flip to REMOVED the moment GitHub reports
// the star is gone, via the periodic sync job. Self-stars (userId owns the
// repository) are rejected at write time — see sync.ts.
model Star {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  status         StarStatus @default(VERIFIED) // sync only ever writes VERIFIED or REMOVED now
  verifiedAt     DateTime?
  lastCheckedAt  DateTime   @default(now())
  starredAt      DateTime? // reported by GitHub, when available
  points         Int        @default(10) // scoring weight, allows future weighting rules

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A user can only be counted once per repository — prevents duplicate counting.
  @@unique([userId, repositoryId])
  @@index([status])
}

enum StarStatus {
  PENDING // legacy value from the old write-based flow; no longer written
  VERIFIED // confirmed currently active on GitHub by the sync job
  REMOVED // GitHub reports the star no longer exists; excluded from score
}

// Append-only activity log for dashboards ("Activity history")
model ActivityEvent {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId String?
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  type    ActivityType
  message String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum ActivityType {
  STAR_VERIFIED
  STAR_REMOVED
  STAR_REQUESTED
  RANK_CHANGED
  SYNC_ERROR
  BUILDER_VERIFIED
  PROJECT_CLAIMED
}

// Records inbound GitHub webhook deliveries for idempotency + debugging
model WebhookDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique // GitHub's X-GitHub-Delivery header
  event      String
  payload    Json
  processedAt DateTime @default(now())
}

// Mutual connections between verified builders. Requesting/accepting both
// require builderVerified — see routes/connections. Pending requests carry
// zero ranking value; only 'accepted' status counts anywhere.
model Connection {
  id           String   @id @default(cuid())
  requesterId  String
  addresseeId  String
  requester    User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User     @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status       ConnectionStatus @default(PENDING)
  createdAt    DateTime @default(now())
  respondedAt  DateTime?

  @@unique([requesterId, addresseeId])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}
