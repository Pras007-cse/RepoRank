# --- Database ---
# PostgreSQL connection string (Supabase, Neon, Railway, RDS, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/reporank"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# The full deployed URL of the app (e.g. https://reporank.vercel.app), or
# http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"

# --- GitHub OAuth App ---
# Create at https://github.com/settings/developers
# Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# --- Token encryption ---
# TOKEN_ENCRYPTION_KEY is no longer required for the star mechanism (this app
# never stars anything on a user's behalf anymore — see lib/scoring.ts), but
# lib/crypto.ts still exposes encrypt/decrypt for potential future use, so
# it's kept optional here rather than ripped out.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# --- Builder session (bio-challenge verification path) ---
# Signs the short-lived session token issued after a successful GitHub-bio
# ownership challenge (src/lib/verification.ts) — the non-OAuth path to
# becoming a "verified builder". Generate with: openssl rand -base64 32
BUILDER_SESSION_SECRET="replace-with-a-long-random-string"

# --- Optional: raises unauthenticated GitHub API rate limits from 60/hr to 5,000/hr ---
# A classic PAT with no scopes (or fine-grained, read-only) is enough for public repo search.
GITHUB_APP_TOKEN=""

# --- GitHub webhooks ---
# Set this as the secret when configuring a webhook (Settings → Webhooks) on
# repos you want real-time star revalidation for, pointed at:
#   <NEXTAUTH_URL>/api/webhooks/github
# Content type: application/json, Events: "Stars"
GITHUB_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"

# --- Periodic revalidation cron ---
# Shared secret required to call /api/cron/revalidate (used by the GitHub
# Actions workflow in .github/workflows/revalidate-stars.yml, or any other
# scheduler you prefer).
CRON_SECRET="replace-with-a-random-cron-secret"
